# PostgreSQL database URL. Create the database first: golden_pride_ticket
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/golden_pride_ticket
# Set a long random secret before deployment.
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_HTTPS_ONLY=false
# Optional: change the first-run demo passwords before the database is seeded.
SEED_ADMIN_PASSWORD=Admin@123
SEED_AGENT_PASSWORD=Agent@123
SEED_CUSTOMER_PASSWORD=customer@123
